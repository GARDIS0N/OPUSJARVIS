# Jarvis Personal AI Manager — Environment Variables (.env.example)
# Copy to .env and fill in ONLY the keys you choose to enable.
# IMPORTANT: .env is git-ignored. Never commit API keys or OAuth secrets.

# --- Local OpenJarvis Paths & Context Window ---
OPENJARVIS_HOME=C:\Users\GARDISON\.gemini\antigravity\scratch\jarvis\openjarvis
JARVIS_NUM_CTX=4096

# --- Optional Weather Tool (OpenWeatherMap) ---
OPENWEATHERMAP_API_KEY=

# --- Optional Google Workspace Connector (Phase 4: jarvis connect gdrive) ---
# Only configure if you approve connecting Google Calendar / Gmail / Tasks.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Optional Cloud Fallback Providers (Local Ollama is always default) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
